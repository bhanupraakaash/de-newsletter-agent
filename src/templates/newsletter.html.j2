<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f3f4f6;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#111827;">
{% macro card(a, n=None) %}
<tr><td style="padding:18px 24px;border-bottom:1px solid #e5e7eb;">
  <div style="font-size:12px;color:#6b7280;margin-bottom:4px;">{{ a.source }}{% if a.published_date %} | {{ a.published_date.strftime('%b %d, %Y') }}{% endif %}</div>
  <div style="font-size:17px;line-height:1.35;font-weight:600;margin-bottom:8px;">
    <a href="{{ a.url }}" style="color:#111827;text-decoration:none;">{% if n %}{{ n }}. {% endif %}{{ a.title }}</a>
  </div>
  {% if a.summary %}<p style="margin:0 0 8px;font-size:14px;line-height:1.5;"><strong>Summary:</strong> {{ a.summary }}</p>{% endif %}
  {% if a.why_it_matters %}<p style="margin:0 0 8px;font-size:14px;line-height:1.5;color:#1e3a8a;"><strong>Why this matters:</strong> {{ a.why_it_matters }}</p>{% endif %}
  {% if a.technologies %}<p style="margin:0 0 12px;font-size:12px;color:#4b5563;"><strong>Technologies:</strong> {{ a.technologies | join(' | ') }}</p>{% endif %}
  <a href="{{ a.url }}" style="display:inline-block;background:#2563eb;color:#ffffff;font-size:13px;font-weight:600;padding:8px 14px;border-radius:6px;text-decoration:none;">Read Article</a>
</td></tr>
{% endmacro %}
{% macro heading(text) %}
<tr><td style="padding:22px 24px 8px;font-size:13px;letter-spacing:1.5px;font-weight:700;color:#2563eb;border-bottom:2px solid #2563eb;">{{ text }}</td></tr>
{% endmacro %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6;">
<tr><td align="center" style="padding:16px 8px;">
<table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;">
  <tr><td style="background:#0f172a;padding:28px 24px;">
    <div style="font-size:26px;font-weight:800;color:#ffffff;">DataPulse AI</div>
    <div style="font-size:14px;color:#93c5fd;margin-top:4px;">Weekly Data Engineering Intelligence</div>
    <div style="font-size:12px;color:#94a3b8;margin-top:10px;">{{ issue_date.strftime('%B %d, %Y') }}</div>
  </td></tr>

  {% if top_stories %}
  {{ heading('TOP STORIES') }}
  {% for a in top_stories %}{{ card(a, loop.index) }}{% endfor %}
  {% endif %}

  {% for title, items in sections %}
  {{ heading(title | upper) }}
  {% for a in items %}{{ card(a) }}{% endfor %}
  {% endfor %}

  {% if learning_pick %}
  {{ heading('WEEKLY LEARNING PICK') }}
  {{ card(learning_pick) }}
  {% endif %}

  <tr><td style="padding:20px 24px;background:#f9fafb;font-size:12px;line-height:1.5;color:#6b7280;">
    Curated automatically by DataPulse AI. Summaries are AI-generated and may contain errors; always check the original article.
    All content belongs to its respective authors.
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
