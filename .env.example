# Copy to .env and fill in real values. NEVER commit .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=your-key-here
CLAUDE_MODEL=claude-haiku-5-5

# --- Email (SMTP). For Gmail: enable 2-Step Verification, then create an "App password". ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com            # comma-separate for several recipients

# --- Cost-control limits ---
MAX_ARTICLES_TO_CLAUDE=20
MAX_SELECTED_ARTICLES=10
MAX_ARTICLE_CHARS=1500
MAX_OUTPUT_TOKENS=2000
MAX_RUN_COST_USD=0.25             # stop calling Claude in a run once it has cost this much
LIFETIME_BUDGET_USD=5.0           # stop calling Claude once total recorded spend reaches this

# --- Misc ---
LOOKBACK_DAYS=7
DB_PATH=data/datapulse.db
OUTPUT_DIR=output
